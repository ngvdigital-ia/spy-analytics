# Nomes das variaveis de ambiente exigidas pelas Vercel Functions (api/*.js).
# Nunca coloque valor real aqui — o .env de verdade fica fora do git (.gitignore ja cobre).

# Connection string do MESMO banco Postgres do banco-de-dados-ngv (Neon, store Banco_de_dados_NGV
# — decisao do operador, custo explicado: nao e mais um projeto Neon separado). As tabelas do
# Spy-Analytics vivem isoladas no schema "spy" (ver schema.sql), e esta string DEVE autenticar
# como o role restrito "spy_app" (ver setup-role.sql) — NUNCA reaproveite a connection string /
# o usuario que o painel NGV usa: esse usuario enxerga o banco inteiro, spy_app so enxerga "spy".
# Formato: postgresql://spy_app:<senha-do-spy_app>@<host-do-projeto-Neon>/<nome-do-banco>?sslmode=require
DATABASE_URL=

# Senha unica compartilhada pelo time (Pedro, Gabriel, Robert) — checada em POST /api/auth.
DASHBOARD_PASSWORD=

# Chave dedicada so pra assinar o cookie de sessao (HMAC-SHA256). NAO reaproveitar DASHBOARD_PASSWORD aqui.
SESSION_SECRET=
