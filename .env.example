# Nomes das variaveis de ambiente exigidas pelas Vercel Functions (api/*.js).
# Nunca coloque valor real aqui — o .env de verdade fica fora do git (.gitignore ja cobre).

# Connection string do projeto Supabase COMPARTILHADO "apps-ofertas" (project ref
# sqzdzhktknfpuaorehnh, sa-east-1) — NAO e um projeto dedicado ao Spy-Analytics. O apps-ofertas
# tem tabelas de compra de cliente real em "public"; o isolamento vem do role restrito "spy_app"
# (ver setup-role.sql), nunca conecte aqui com o role "postgres" (dono do projeto, enxerga tudo).
# Use a connection string do POOLER (Supavisor, modo transaction, porta 6543) — nunca a conexao
# direta (porta 5432): em serverless cada invocacao pode abrir conexao nova, e a porta direta tem
# teto baixo de conexoes simultaneas no Postgres.
# Pegue em Project Settings > Database > Connection string > "Transaction pooler" no dashboard do
# Supabase — o USUARIO precisa ser "spy_app.<ref>", nao "postgres.<ref>" (troque manualmente, o
# dashboard mostra "postgres" por padrao).
# Formato: postgresql://spy_app.<ref-do-projeto>:<senha-do-spy_app>@aws-N-<regiao>.pooler.supabase.com:6543/postgres
# O prefixo "aws-N" VARIA por projeto (o apps-ofertas usa aws-1, nao aws-0) e o host errado NAO
# falha de forma obvia: resolve em DNS e o Supavisor devolve "tenant/user ... not found", que
# parece "role custom nao suportado" e manda o diagnostico pro lado errado. Copie o host do
# dashboard, nunca monte por analogia com outro projeto (medido em 2026-07-31).
DATABASE_URL=

# Senha unica compartilhada pelo time (Pedro, Gabriel, Robert) — checada em POST /api/auth.
DASHBOARD_PASSWORD=

# Chave dedicada so pra assinar o cookie de sessao (HMAC-SHA256). NAO reaproveitar DASHBOARD_PASSWORD aqui.
SESSION_SECRET=

# Autoriza o Vercel Cron a chamar GET /api/cron-prontas (ADR-002). A Vercel manda
# "Authorization: Bearer <CRON_SECRET>" automaticamente em toda chamada de cron — gere uma
# string aleatoria >= 16 chars (ex.: openssl rand -base64 24). SEM esta variavel configurada, o
# endpoint recusa TODA chamada (fail-closed) — nunca fica aberto por omissao.
CRON_SECRET=

# Projeção agregada interna para consumidores server-to-server (ex.: Banco NGV). Fechada por
# padrão; quando ativada, aceita somente Authorization: Bearer SPY_PROJECTION_SECRET. Este
# segredo é dedicado e NÃO pode ser DASHBOARD_PASSWORD, SESSION_SECRET ou CRON_SECRET.
SPY_PROJECTION_ENABLED=false
SPY_PROJECTION_SECRET=

# Chave service_role do projeto Supabase do NGV Core — usada server-side pelo cron diario
# GET /api/sync-ngv-core pra autenticar o POST do snapshot agregado no endpoint
# spy-snapshot-ingest. Nunca vai pra log nem pra resposta, e NAO e o SPY_PROJECTION_SECRET
# (este autentica o Spy falando COM o NGV Core; aquele autentica quem fala COM o Spy). SEM esta
# variavel, o cron responde "configuracao ausente" sem consultar banco nem rede.
NGV_CORE_SERVICE_ROLE_KEY=

# URL do Incoming Webhook do Slack pro canal que recebe o aviso de "oferta pronta pra modelar"
# (ADR-002). OPCIONAL: enquanto o canal do Slack nao existir/nao tiver o Incoming Webhook
# configurado, deixe esta variavel VAZIA OU AUSENTE — o cron continua rodando normalmente, so
# NAO notifica ninguem (fica pendente, ver README "Cron de notificação"). A aba "Prontas pra
# modelar" no app NUNCA depende desta variavel.
SLACK_WEBHOOK_URL=
