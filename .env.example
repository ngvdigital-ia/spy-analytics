# Nomes das variaveis de ambiente exigidas pelas Vercel Functions (api/*.js).
# Nunca coloque valor real aqui — o .env de verdade fica fora do git (.gitignore ja cobre).

# Connection string do projeto Supabase DEDICADO ao Spy-Analytics (nao compartilhado com o painel
# NGV nem com nenhum outro produto). Use a connection string do POOLER (Supavisor, modo
# transaction, porta 6543) — nunca a conexao direta (porta 5432): em serverless cada invocacao
# pode abrir conexao nova, e a porta direta tem teto baixo de conexoes simultaneas no Postgres.
# Pegue em Project Settings > Database > Connection string > "Transaction pooler" no dashboard do
# Supabase.
# Formato: postgresql://postgres.<ref-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Senha unica compartilhada pelo time (Pedro, Gabriel, Robert) — checada em POST /api/auth.
DASHBOARD_PASSWORD=

# Chave dedicada so pra assinar o cookie de sessao (HMAC-SHA256). NAO reaproveitar DASHBOARD_PASSWORD aqui.
SESSION_SECRET=
