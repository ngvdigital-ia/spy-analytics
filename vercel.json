{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron-prontas", "schedule": "0 11,23 * * *" },
    { "path": "/api/sync-ngv-core", "schedule": "0 1 * * *" }
  ]
}
